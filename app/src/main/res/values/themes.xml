<resources>
    <style name="Theme.Camasir" parent="Theme.Camasir.Base"/>
    <style name="Theme.Camasir.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nav_active</item>
        <item name="colorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/page</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Camasir.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Camasir.NavIndicator" parent="">
        <item name="android:width">36dp</item>
        <item name="android:height">36dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/Camasir.NavCircle</item>
        <item name="android:color">@color/nav_indicator</item>
    </style>
    <style name="Camasir.NavCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <color name="nav_indicator">#EDF2F8</color>
    <color name="nav_active">#183456</color>
    <color name="page">#F7F9FC</color>
    <color name="card">#FFFFFF</color>
    <color name="ink">#142C50</color>
    <color name="muted">#667D95</color>
    <color name="line">#DCE5F0</color>
</resources>

