<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:gravity="center_vertical" android:padding="10dp">
        <ImageView tools:src="@drawable/ic_machine" android:id="@+id/icon" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView tools:text="Çamaşır makinesi 1" android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="14sp"/>
            <TextView tools:text="Kullanıma hazır" android:id="@+id/detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp"/>
        </LinearLayout>
        <TextView tools:text="Boş" android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:paddingHorizontal="8dp" android:paddingVertical="5dp"/>
        <TextView android:id="@+id/chevron" android:layout_width="22dp" android:layout_height="wrap_content" android:gravity="end" android:text="›" android:textColor="@color/muted" android:textSize="20sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>